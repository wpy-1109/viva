# 复制为 .env 后由你自己的进程管理器加载。不要提交 .env，也不要把密钥发到聊天里。
VIVA_HOST=127.0.0.1
VIVA_PORT=43123
VIVA_DATA_DIR=./data
VIVA_ALLOW_NONLOCAL=
VIVA_DOCKER=
VIVA_WORKER_CONCURRENCY=2

# 真实模型。留空则使用界面里的演示提供者。协议是 OpenAI Chat Completions，不绑定某一家供应商。
VIVA_MODEL_BASE_URL=
VIVA_MODEL_NAME=
VIVA_MODEL_API_KEY=

# 可选。设置后 Viva 只会执行： "<路径>" --version
VIVA_DSH_BIN=

# 读取私有 GitHub 仓库时使用。公开仓库可以留空。
VIVA_GITHUB_TOKEN=
