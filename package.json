{
  "name": "viva",
  "version": "0.2.1",
  "private": true,
  "description": "本地优先的知识工程工作台",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run build:web && concurrently -k \"vite build --watch --config vite.config.ts\" \"tsx watch src/server/main.ts\" \"tsx src/worker/main.ts\"",
    "build:web": "vite build --config vite.config.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server/main.js",
    "viva": "node scripts/viva.mjs",
    "worker": "node dist/worker/main.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke": "node scripts/run-smoke.mjs",
    "backup": "node scripts/run-backup.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "better-sqlite3": "^12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.2",
    "fastify": "^5.6.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.1.2"
  }
}
